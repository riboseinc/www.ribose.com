---
import BaseLayout from '../../../layouts/Base.astro'
import PageHero from '../../../components/PageHero.astro'
import { advisories } from '../../../lib/advisories'

const all = advisories()
---
<BaseLayout title="Security Advisories" description="Ribose security advisories (CVE Numbering Authority)." path="/security/advisories">
  <PageHero eyebrow="Security" title="Security Advisories" crumbs={[{ href: '/security', label: 'Security' }, { label: 'Advisories' }]}>
    <p class="mt-3 text-slate-600 dark:text-slate-400">Ribose is a CVE Numbering Authority. Policy: <a href="/cve-policy">CVE policy</a>.</p>
    <div class="mt-8 space-y-4">
      {all.map((advisory) => (
        <a href={`/security/advisories/${advisory.slug}`} class="block rounded-2xl border border-slate-200 bg-white p-5 no-underline hover:border-brand-400 dark:border-slate-800 dark:bg-ink-2">
          <p class="font-mono text-sm text-brand-700 dark:text-brand-400">{advisory.id}{advisory.cveId ? ` · ${advisory.cveId}` : ''}</p>
          <h2 class="mt-1 font-semibold">{advisory.title.replace(/^[^:]+:\s*/, '')}</h2>
          <time class="text-xs text-slate-500 dark:text-slate-400">{advisory.date}</time>
        </a>
      ))}
    </div>
  </PageHero>
</BaseLayout>
