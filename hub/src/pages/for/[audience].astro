---
import { parse as parseYaml } from 'yaml'
import audiencesRaw from '../../../data/audiences.yaml?raw'
import BaseLayout from '../../layouts/Base.astro'
import PlatformCard from '../../components/PlatformCard.astro'
import { platforms } from '../../lib/registry'
import { breadcrumbJsonLd } from '../../lib/seo'
import { t } from '../../lib/i18n'
import PageHero from '../../components/PageHero.astro'

export function getStaticPaths() {
  const audiences = (parseYaml(audiencesRaw) as { audiences: { id: string; name: string; pain: string; answer: string }[] }).audiences
  return audiences.map((audience) => ({ params: { audience: audience.id }, props: { audience } }))
}
const { audience } = Astro.props
const jsonLd = [breadcrumbJsonLd([{ name: 'For ' + audience.name, path: `/for/${audience.id}` }])]
---
<BaseLayout title={`For ${audience.name}`} description={audience.answer} path={`/for/${audience.id}`} jsonLd={jsonLd}>
  <PageHero eyebrow="For" title={audience.name} lede={audience.pain}>
    <p class="mt-3 max-w-2xl text-lg font-medium">{audience.answer}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {platforms.map((platform) => <PlatformCard platform={platform} />)}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/technologies" class="btn-solid">{t('cta.explore')}</a>
      <a href="mailto:info@ribose.com" class="btn-outline">{t('cta.talk')}</a>
    </div>
  </PageHero>
</BaseLayout>
