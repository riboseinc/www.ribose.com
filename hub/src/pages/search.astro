---
import BaseLayout from '../layouts/Base.astro'
import PageHero from '../components/PageHero.astro'
---
<BaseLayout title="Search" description="Search ribose.com — platforms, technologies, news, and company pages." path="/search">
  <PageHero eyebrow="Search" title="Find anything on ribose.com" lede="Platforms, technologies, news, security advisories, and company pages." width="compact">

    <div class="mt-8 overflow-hidden rounded-2xl border border-line bg-white shadow-sm dark:border-slate-800 dark:bg-ink-2">
      <div class="flex items-center gap-3 border-b border-line px-4 dark:border-slate-700">
        <svg class="h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="page-search-input" class="sp-input h-14" type="text" placeholder="Search ribose.com…" autocomplete="off" spellcheck="false"
          role="combobox" aria-expanded="true" aria-controls="page-search-results" aria-autocomplete="list" />
      </div>
      <div id="page-search-results" role="listbox" aria-label="Search results" class="max-h-[60vh] overflow-y-auto p-2"></div>
    </div>

    <p class="mt-6 text-xs text-slate-500 dark:text-slate-500">Tip: press <kbd class="kbd">⌘K</kbd> or <kbd class="kbd">/</kbd> anywhere on the site to search.</p>
  </PageHero>

  <script>
    import { loadPagefind, search, renderResults, debounce } from '../lib/searchCore'

    const input = document.getElementById('page-search-input') as HTMLInputElement
    const list = document.getElementById('page-search-results') as HTMLElement
    const run = async () => {
      const q = input.value.trim()
      if (!q) { renderResults(list, [], 'Type to search.') ; return }
      const hits = await search(q, 12)
      renderResults(list, hits, hits.length ? undefined : 'No results for “' + q + '”.')
    }
    const debouncedRun = debounce(run)

    input.addEventListener('input', debouncedRun)
    renderResults(list, [], 'Type to search.')
    loadPagefind().then((pf) => { if (!pf) renderResults(list, [], 'Search index unavailable. Build the site once (npm run build) and reload.') })
  </script>
</BaseLayout>
