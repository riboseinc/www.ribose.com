---
import BaseLayout from '../../layouts/Base.astro'
import { allArticles, articleKind, type ArticleKind } from '../../lib/newsIndex'
import type { Article } from '../../lib/article'
import { productMarkFor } from '../../lib/identity'
import BrandMark from '../../components/BrandMark.astro'

const all = await allArticles()
const counts = all.reduce((acc, a) => { acc[articleKind(a)] = (acc[articleKind(a)] ?? 0) + 1; return acc }, {} as Record<ArticleKind, number>)
const archiveCount = counts.archive ?? 0
const years = [...new Set(all.map((a) => a.date.slice(0, 4)))].sort((a, b) => b.localeCompare(a))

const kindChip = (a: Article) => articleKind(a)

const chips = [
  { filter: 'kind:news', label: 'News', icon: 'r', count: counts.news ?? 0 },
  { filter: 'kind:archive', label: 'Platform archive', icon: 'archive', count: archiveCount },
  { filter: 'kind:products', label: 'Products', icon: 'signal', count: counts.products ?? 0 },
  { filter: 'kind:', label: 'All', icon: 'grid', count: all.length },
]
---
<BaseLayout title="News" description="News from across the Ribose technology network and the full archive since 2012." path="/news">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="eyebrow">Newsroom</p>
    <h1 class="h-display mt-2 text-4xl font-bold sm:text-5xl">News</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      Corporate announcements, product launches, and standards work — the full press archive
      since 2012, with product articles republished in full (canonical at their origin site).
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <span class="text-slate-500 dark:text-slate-500">Feeds:</span>
      <a href="/news/feed.xml" class="font-semibold text-brand-700 no-underline hover:underline dark:text-brand-400">RSS</a>
      <span aria-hidden="true" class="text-slate-400 dark:text-slate-600">·</span>
      <a href="/news-data/feed.json" class="font-semibold text-brand-700 no-underline hover:underline dark:text-brand-400">ninjs</a>
      <span aria-hidden="true" class="text-slate-400 dark:text-slate-600">·</span>
      <a href="/news-data/newsml.xml" class="font-semibold text-brand-700 no-underline hover:underline dark:text-brand-400">NewsML-G2</a>
    </div>

    <div class="sticky top-16 z-30 -mx-4 mt-8 border-b border-line bg-paper/90 px-4 py-4 backdrop-blur-xl sm:-mx-6 sm:px-6 dark:border-slate-800 dark:bg-ink/90">
      <div class="flex flex-col gap-3">
        <div class="relative">
          <label class="sr-only" for="news-search">Search news</label>
          <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="news-search" type="search" placeholder="Search headlines…" autocomplete="off" spellcheck="false"
            class="h-11 w-full rounded-xl border border-line bg-white pl-10 pr-20 text-base text-ink outline-none transition placeholder:text-slate-400 focus-visible:border-brand-500 dark:border-slate-700 dark:bg-ink-2 dark:text-slate-100" />
          <span id="news-count" class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold tabular-nums text-slate-500 dark:text-slate-400" aria-live="polite"></span>
        </div>
        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter news">
          {chips.map((chip) => (
            <button type="button" class="news-filter-chip" data-news-filter={chip.filter} aria-pressed={chip.filter === 'kind:news' ? 'true' : 'false'}>
              {chip.icon === 'r' && <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.44 15.54V4.46h5.18c2.78 0 4.56 1.56 4.56 3.96 0 1.82-.98 3.14-2.66 3.66l3.24 3.46h-2.86l-2.86-3.14H6.9v3.14H4.44Zm2.46-5.12h2.6c1.42 0 2.24-.7 2.24-1.94 0-1.24-.82-1.92-2.24-1.92h-2.6v3.86Z"/></svg>}
              {chip.icon === 'archive' && <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/></svg>}
              {chip.icon === 'signal' && <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 8.82a15 15 0 0 1 20 0"/><path d="M5 12.86a10 10 0 0 1 14 0"/><path d="M8.5 16.43a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1" fill="currentColor" stroke="none"/></svg>}
              {chip.icon === 'grid' && <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>}
              {chip.label}
              <span class="text-[10px] tabular-nums opacity-60">{chip.count}</span>
            </button>
          ))}
          <span class="mx-1 h-5 w-px bg-line dark:bg-slate-800" aria-hidden="true"></span>
          {years.map((y) => (
            <button type="button" class="news-filter-chip !px-2.5 !text-xs tabular-nums" data-news-filter={`year:${y}`} aria-pressed="false">{y}</button>
          ))}
          <button type="button" id="news-reset" class="ml-auto text-xs font-semibold text-brand-700 no-underline hover:underline dark:text-brand-400 hidden">Clear filters</button>
        </div>
      </div>
    </div>

    <div id="news-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {all.map((item) => {
        const kind = kindChip(item)
        const mark = kind === 'products' ? productMarkFor(item.origin) : undefined
        return (
          <a href={item.href} data-kind={kind} data-year={item.date.slice(0, 4)} data-title={item.title.toLowerCase()}
            class:list={['card group flex flex-col p-5', kind === 'archive' && 'hidden']}>
            <div class="flex items-baseline justify-between gap-2">
              <time class="text-xs text-slate-500 dark:text-slate-500">{item.date}</time>
              {mark && (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-2 py-0.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-ink-2 dark:text-slate-300">
                  <BrandMark mark={mark} name={item.origin} imgClass="h-3.5 w-3.5" fallback="none" />
                  {item.origin}
                </span>
              )}
              {kind === 'archive' && <span class="rounded-full border border-line px-2 py-0.5 text-xs text-slate-400 dark:border-slate-700 dark:text-slate-500">archive</span>}
            </div>
            <h3 class="mt-2.5 font-semibold leading-snug group-hover:text-brand-700 dark:group-hover:text-brand-300">{item.title}</h3>
            <span class="mt-4 text-sm font-medium text-brand-700 no-underline group-hover:underline dark:text-brand-400">Read <span class="read-arrow" aria-hidden="true">→</span></span>
          </a>
        )
      })}
    </div>
    <p id="news-empty" class="mt-8 hidden text-center text-sm text-slate-500">No articles match. <button type="button" id="news-empty-reset" class="font-semibold text-brand-700 underline underline-offset-4 dark:text-brand-400">Clear filters</button></p>
  </section>

  <script>
    const grid = () => document.getElementById('news-grid')
    const countEl = () => document.getElementById('news-count')
    const emptyEl = () => document.getElementById('news-empty')
    const resetBtn = () => document.getElementById('news-reset')
    const searchEl = () => document.getElementById('news-search') as HTMLInputElement
    const state = { query: '', chip: 'kind:news' }

    const apply = () => {
      const g = grid(); if (!g) return
      const q = state.query.trim().toLowerCase()
      const [fk, fv] = state.chip.split(':')
      let shown = 0
      g.querySelectorAll<HTMLElement>('[data-kind]').forEach((card) => {
        const okKind = fk === 'kind' ? fv === '' || card.dataset.kind === fv : true
        const okYear = fk === 'year' ? card.dataset.year === fv : true
        const okQuery = !q || (card.dataset.title ?? '').includes(q)
        const visible = okKind && okYear && okQuery
        card.classList.toggle('hidden', !visible)
        if (visible) shown++
      })
      countEl()!.textContent = `${shown} of ${g.querySelectorAll('[data-kind]').length}`
      emptyEl()!.classList.toggle('hidden', shown > 0)
      resetBtn()!.classList.toggle('hidden', state.query === '' && state.chip === 'kind:news')
    }

    document.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-news-filter]')
      if (chip) {
        state.chip = chip.dataset.newsFilter ?? 'kind:news'
        grid()!.parentElement!.querySelectorAll('.news-filter-chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)))
        apply(); return
      }
      if ((e.target as HTMLElement).closest('#news-reset,#news-empty-reset')) {
        state.query = ''; state.chip = 'kind:news'
        searchEl()!.value = ''
        grid()!.parentElement!.querySelectorAll('.news-filter-chip').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.newsFilter === 'kind:news')))
        apply()
      }
    })

    let timer: ReturnType<typeof setTimeout> | undefined
    document.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).id !== 'news-search') return
      clearTimeout(timer)
      timer = setTimeout(() => { state.query = searchEl().value; apply() }, 120)
    })
    apply()
  </script>
</BaseLayout>
