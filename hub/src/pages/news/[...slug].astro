---
import BaseLayout from '../../layouts/Base.astro'
import ArticleShell from '../../components/ArticleShell.astro'
import { allArticles, articleKind } from '../../lib/newsIndex'
import type { Article } from '../../lib/article'
import { newsArticleJsonLd, breadcrumbJsonLd } from '../../lib/seo'

export async function getStaticPaths() {
  const all = await allArticles()
  return all.map((article) => ({ params: { slug: article.href.replace('/news/', '') }, props: { article } }))
}

const { article } = Astro.props as { article: Article }
const canonicalPath = article.href
const kind = articleKind(article)
const isZh = article.lang === 'zh-hant'

// prev/next within the same stream (news vs archive), newest first
const sameStream = (await allArticles()).filter((a) =>
  isZh ? a.lang === 'zh-hant' : articleKind(a) === kind,
)
const i = sameStream.findIndex((a) => a.urn === article.urn)
const prev = sameStream[i - 1]
const next = sameStream[i + 1]

const jsonLd = [
  breadcrumbJsonLd([{ name: 'News', path: '/news' }, { name: article.title, path: canonicalPath }]),
  newsArticleJsonLd({ headline: article.title, canonical: article.canonical, published: article.date, language: article.lang }),
]
---
<BaseLayout
  title={article.title}
  description={article.subheadline ?? article.title}
  path={canonicalPath}
  type="article"
  publishedTime={article.date}
  jsonLd={jsonLd}
  canonicalHref={article.origin !== 'ribose.com' ? article.canonical : undefined}
>
  <ArticleShell
    crumbs={[{ href: '/news', label: 'News' }]}
    title={article.title}
    sub={article.subheadline}
    date={article.date}
    lang={isZh ? article.lang : undefined}
    bodyHtml={article.bodyHtml}
    media={article.media?.[0] ? { href: article.media[0].href, alt: article.media[0].alt, credit: article.media[0].credit } : null}
    notice={article.archived
      ? 'From the Ribose collaboration platform archive (2012–2023) — announcements from the discontinued collaboration platform product.'
      : undefined}
    prevNext={{
      prev: prev ? { href: prev.href, title: prev.title } : undefined,
      next: next ? { href: next.href, title: next.title } : undefined,
    }}
    share={{ url: article.canonical, title: article.title }}
  >
    {article.origin !== 'ribose.com' && (
      <footer class="mt-10 max-w-3xl rounded-2xl border border-brand-200 bg-brand-50 p-5 text-sm dark:border-slate-700 dark:bg-ink-2">
        <p>Published at <a href={article.canonical} class="font-semibold">{article.origin}</a></p>
        {article.authors.length > 0 && (
          <p class="mt-1 text-slate-600 dark:text-slate-400">By {article.authors.map((a) => a.name).join(', ')}</p>
        )}
      </footer>
    )}
  </ArticleShell>
</BaseLayout>
