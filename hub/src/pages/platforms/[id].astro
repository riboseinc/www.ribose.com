---
import BaseLayout from '../../layouts/Base.astro'
import EdgeLinks from '../../components/EdgeLinks.astro'
import { platforms, platformById, suitesOfPlatform } from '../../lib/registry'
import { breadcrumbJsonLd } from '../../lib/seo'
import BrandMark from '../../components/BrandMark.astro'
import Crumbs from '../../components/Crumbs.astro'
import { platformMark } from '../../lib/identity'

export function getStaticPaths() {
  return platforms.map((platform) => ({ params: { id: platform.id } }))
}

const { id } = Astro.params
const platform = platformById(id!)
const members = suitesOfPlatform(platform!)
const buildsOn = platform!.builds_on ? platformById(platform!.builds_on) : undefined
const jsonLd = [breadcrumbJsonLd([
  { name: 'Platforms', path: '/platforms' },
  { name: platform!.name, path: `/platforms/${platform!.id}` },
])]
---
<BaseLayout title={platform!.name} description={platform!.tagline} path={`/platforms/${platform!.id}`} jsonLd={jsonLd}>
  <article class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <Crumbs items={[{ href: '/platforms', label: 'Platforms' }, { label: platform!.name }]} />
    <div transition:name={`platform-${platform!.id}`}>
      <BrandMark mark={platformMark(platform!.id, 'logo')} name={platform!.name} imgClass="mt-6 h-10 w-auto" fallback="none" />
      <p class="eyebrow mt-4 text-brand-700 dark:text-brand-400">{platform!.vendor ?? 'Ribose'} platform</p>
    <h1 class="h-display mt-2 text-4xl font-bold sm:text-5xl">{platform!.name}</h1>
      <p class="mt-3 text-xl text-slate-600 dark:text-slate-300">{platform!.tagline}</p>
    </div>
    <p class="prose-news mt-6 max-w-3xl">{platform!.story}</p>

    {buildsOn && (
      <p class="mt-4 rounded-xl border border-brand-200 bg-brand-50 p-4 text-sm dark:border-slate-700 dark:bg-ink-2">
        Builds on the <a class="font-semibold no-underline" href={`/platforms/${buildsOn.id}`}>{buildsOn.name}</a> platform.
      </p>
    )}

    {platform!.editions?.length ? (
      <section class="mt-8">
        <p class="eyebrow">Editions</p>
        <h2 class="h-display mt-2 text-2xl font-bold">Choose your edition</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {platform!.editions.map((edition) => (
            <div class="card p-5">
              <p class="font-semibold">{edition.name}</p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{edition.description}</p>
            </div>
          ))}
        </div>
      </section>
    ) : null}

    <section class="mt-10">
      <p class="eyebrow">Open source</p>
      <h2 class="h-display mt-2 text-2xl font-bold">Built from {members.length} open-source suites</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((suite) => (
          <a href={`/technologies/${suite.id}`} class="card group block p-5">
            <p class="font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-300">{suite.name}{platform!.core === suite.id && <span class="ml-2 rounded-full bg-brand-600 px-2 py-0.5 text-[11px] font-semibold text-white">core</span>}</p>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{suite.tagline}</p>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
