---
import BaseLayout from '../../layouts/Base.astro'
import PlatformCard from '../../components/PlatformCard.astro'
import PageHero from '../../components/PageHero.astro'
import { platforms } from '../../lib/registry'
---
<BaseLayout title="Platforms" description="The Ribose platforms: Metanorma for standards publication, Primmel Digital CAB for SMART standards workflows." path="/platforms">
  <PageHero eyebrow="Platforms" title="Platforms" lede="Complete offerings assembled from our open-source suites — adopt the whole platform, or just the pieces.">
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {platforms.map((platform) => <PlatformCard platform={platform} />)}
    </div>
  </PageHero>
</BaseLayout>
