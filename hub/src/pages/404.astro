---
import BaseLayout from '../layouts/Base.astro'
import { navItems, navLabel } from '../lib/nav'
const links = navItems.map((item) => ({ href: item.href, label: navLabel(item), desc: item.desc }))
---
<BaseLayout title="Not found" description="Page not found">
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32">
      <p class="h-display text-7xl font-bold text-brand-500 sm:text-8xl" aria-hidden="true">404</p>
      <h1 class="h-display mt-4 text-2xl font-bold sm:text-3xl">This page does not exist</h1>
      <p class="mx-auto mt-3 max-w-md text-slate-600 dark:text-slate-400">
        The link may be outdated — or what you're looking for has a new home.
        Search the site, or start from one of these:
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button type="button" data-search-toggle class="btn-solid">Search the site</button>
        <a href="/" class="btn-outline">Go home</a>
      </div>
      <div class="mx-auto mt-12 grid max-w-xl gap-3 sm:grid-cols-2">
        {links.map((l) => (
          <a href={l.href} class="card block p-4 text-left">
            <p class="font-semibold">{l.label}</p>
            <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{l.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
