---
// Site-wide search palette (⌘K / Ctrl-K, or the header search button).
// Results come from the Pagefind index built into /pagefind after `astro build`.
---
<dialog id="search-palette" class="sp-dialog" aria-label="Search ribose.com">
  <div class="sp-panel">
    <div class="flex items-center gap-3 border-b border-line px-4 dark:border-slate-700">
      <svg class="h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="sp-input" class="sp-input h-14" type="text" placeholder="Search ribose.com…" autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="true" aria-controls="sp-results" aria-autocomplete="list" />
      <kbd class="kbd shrink-0">esc</kbd>
    </div>
    <div id="sp-results" role="listbox" aria-label="Search results" aria-live="polite" class="max-h-[55vh] overflow-y-auto p-2"></div>
    <div class="flex items-center justify-between border-t border-line px-4 py-2 text-[11px] text-slate-500 dark:border-slate-700 dark:text-slate-500">
      <span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> navigate &nbsp; <kbd class="kbd">↵</kbd> open</span>
      <span>Search by Pagefind</span>
    </div>
  </div>
</dialog>

<script>
  import { loadPagefind, search, renderResults, debounce } from '../lib/searchCore'

  const dlg = () => document.getElementById('search-palette') as HTMLDialogElement
  const input = () => document.getElementById('sp-input') as HTMLInputElement
  const list = () => document.getElementById('sp-results') as HTMLElement
  let active = -1

  const render = (hits: any[], note?: string) => {
    active = -1
    renderResults(list(), hits, note, (a, _hit, i) => {
      a.setAttribute('role', 'option')
      a.dataset.index = String(i)
    })
  }

  const setActive = (i: number) => {
    const rows = list().querySelectorAll('[role="option"]')
    rows.forEach((el, idx) => el.setAttribute('aria-selected', String(idx === i)))
    active = i
    rows[i]?.scrollIntoView({ block: 'nearest' })
  }

  const QUICK = [
    { title: 'Platforms', url: '/platforms', section: 'Go to' },
    { title: 'Technologies', url: '/technologies', section: 'Go to' },
    { title: 'News', url: '/news', section: 'Go to' },
    { title: 'Customers', url: '/customers', section: 'Go to' },
    { title: 'Company', url: '/company', section: 'Go to' },
    { title: 'Security', url: '/security', section: 'Go to' },
  ]

  const renderQuick = () => {
    const box = list()
    box.replaceChildren()
    active = -1
    const label = document.createElement('p')
    label.className = 'eyebrow px-3 pt-2 pb-1'
    label.textContent = 'Quick links'
    box.append(label)
    QUICK.forEach((hit, i) => {
      const a = document.createElement('a')
      a.href = hit.url
      a.className = 'sp-row block no-underline'
      a.setAttribute('role', 'option')
      a.dataset.index = String(i)
      const t = document.createElement('span')
      t.className = 'truncate font-medium'
      t.textContent = hit.title
      const m = document.createElement('span')
      m.className = 'sp-meta'
      m.textContent = hit.section
      a.append(t, m)
      box.append(a)
    })
  }

  const run = async () => {
    const q = input().value.trim()
    if (!q) { renderQuick() ; return }
    const hits = await search(q, 8)
    render(hits, hits.length ? undefined : 'No results for “' + q + '”.')
  }
  const debouncedRun = debounce(run)

  const open = () => {
    const d = dlg()
    if (!d.open) d.showModal()
    input().focus()
    input().select()
    if (!input().value.trim()) renderQuick()
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    if (target.closest('[data-search-toggle]')) { e.preventDefault(); open() }
    if (target === dlg()) dlg().close()
  })

  document.addEventListener('keydown', (e) => {
    const d = dlg()
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); d.open ? d.close() : open() }
    if (e.key === '/' && !d.open && !(e.target as HTMLElement)?.closest('input, textarea, select')) { e.preventDefault(); open() }
    if (!d.open) return
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault()
      const rows = list().querySelectorAll('[role="option"]')
      const n = rows.length
      if (!n) return
      setActive(e.key === 'ArrowDown' ? (active + 1) % n : (active - 1 + n) % n)
    }
    if (e.key === 'Enter') {
      e.preventDefault()
      const chosen = list().querySelector(`[data-index="${active}"]`) as HTMLAnchorElement | null
      if (chosen) { d.close(); chosen.click() }
    }
  })

  document.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).id === 'sp-input') debouncedRun()
  })

  document.addEventListener('mousemove', (e) => {
    const el = (e.target as HTMLElement).closest?.('[role="option"]') as HTMLElement | null
    if (el && el.dataset.index !== undefined && Number(el.dataset.index) !== active) setActive(Number(el.dataset.index))
  })

  loadPagefind().then((pf) => {
    if (!pf) render([], 'Search index unavailable. Build the site once (npm run build) and reload.')
  })
</script>
