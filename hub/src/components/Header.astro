---
import { navItems, navLabel } from '../lib/nav'
import type { Locale } from '../lib/i18n'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const nav = navItems.map((item) => ({ href: item.href, label: navLabel(item, lang) }))
const current = Astro.url.pathname
---
<header class="site-header sticky top-0 z-40">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center no-underline" aria-label="Ribose home">
      <img src="/brand/ribose-logo.svg" alt="Ribose" width="118" height="28" class="h-7 w-auto dark:hidden" />
      <img src="/brand/ribose-logo-white.svg" alt="Ribose" width="118" height="28" class="hidden h-7 w-auto dark:block" />
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', current.startsWith(item.href) && 'font-semibold']}
          aria-current={current.startsWith(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button type="button" data-search-toggle class="group flex h-10 items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-500 transition hover:border-slate-300 hover:text-ink dark:border-slate-800 dark:bg-ink-2 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-white" aria-label="Search" data-pagefind-ignore>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="kbd ml-1 hidden lg:inline">⌘K</kbd>
      </button>
      <button id="theme-toggle" type="button" class="icon-btn border border-slate-200 dark:border-slate-800" aria-label="Toggle dark mode" aria-pressed="false">
        <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button id="menu-toggle" type="button" class="icon-btn border border-slate-200 md:hidden dark:border-slate-800" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line md:hidden dark:border-slate-800" aria-label="Mobile">
    <div class="mx-auto max-w-6xl space-y-0.5 px-4 py-3 sm:px-6">
      {nav.map((item) => (
        <a href={item.href} class:list={['nav-link block w-full', current.startsWith(item.href) && 'font-semibold']} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  document.addEventListener('click', function (e) {
    var themeBtn = e.target.closest('#theme-toggle')
    if (themeBtn) {
      var apply = function () {
        var dark = document.documentElement.classList.toggle('dark')
        localStorage.setItem('theme', dark ? 'dark' : 'light')
        themeBtn.setAttribute('aria-pressed', String(dark))
      }
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (document.startViewTransition && !reduce) document.startViewTransition(apply)
      else apply()
      return
    }
    var menuBtn = e.target.closest('#menu-toggle')
    if (menuBtn) {
      var nav = document.getElementById('mobile-nav')
      var open = nav.classList.toggle('hidden') === false
      menuBtn.setAttribute('aria-expanded', String(open))
    }
  })
</script>
