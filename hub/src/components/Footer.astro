---
import { stats } from '../lib/registry'
import { navItems, navLabel } from '../lib/nav'
import type { Locale } from '../lib/i18n'
interface Props { lang?: Locale }
const { lang = 'en' } = Astro.props
const s = stats()
const year = new Date().getFullYear()
const siteLinks = navItems.map((item) => ({ href: item.href, label: navLabel(item, lang) }))
const networkLinks = [
  { href: 'https://github.com/riboseinc', label: 'GitHub', external: true },
  { href: '/news/feed.xml', label: 'News feed' },
  { href: 'https://www.openpgp.org/', label: 'OpenPGP keys', external: true },
  { href: '/feedback', label: 'Feedback' },
]
const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/tos', label: 'Terms' },
]
---
<footer class="border-t border-line dark:border-slate-800">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <img src="/brand/ribose-logo.svg" alt="Ribose" width="118" height="28" class="h-7 w-auto dark:hidden" />
        <img src="/brand/ribose-logo-white.svg" alt="Ribose" width="118" height="28" class="hidden h-7 w-auto dark:block" />
        <p class="mt-4 max-w-xs text-sm leading-6 text-slate-600 dark:text-slate-400">Open digital infrastructure for the world's standards community.</p>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-500">{s.platforms} platforms · {s.suites} suites · {s.softwares}+ open-source repositories.</p>
      </div>
      <nav aria-label="Site">
        <p class="eyebrow">Site</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {siteLinks.map((l) => <li><a href={l.href} class="text-slate-600 no-underline hover:text-ink hover:underline dark:text-slate-400 dark:hover:text-white">{l.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Network">
        <p class="eyebrow">Network</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {networkLinks.map((l) => <li><a href={l.href} class="text-slate-600 no-underline hover:text-ink hover:underline dark:text-slate-400 dark:hover:text-white" rel={l.external ? 'noopener' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Legal">
        <p class="eyebrow">Legal</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {legalLinks.map((l) => <li><a href={l.href} class="text-slate-600 no-underline hover:text-ink hover:underline dark:text-slate-400 dark:hover:text-white">{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-500">
      <p>© {year} Ribose Group Inc. Content under open licenses.</p>
      <p>Built in the open · <a href="https://github.com/riboseinc" class="underline hover:text-ink dark:hover:text-white" rel="noopener">riboseinc on GitHub</a></p>
    </div>
  </div>
</footer>
